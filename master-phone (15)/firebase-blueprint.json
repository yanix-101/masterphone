{
  "entities": {
    "products": {
      "title": "Products",
      "description": "Products available in store catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "brand": { "type": "string" },
        "condition": { "type": "string" },
        "specEn": { "type": "string" },
        "specAr": { "type": "string" },
        "priceUsd": { "type": "number" },
        "rating": { "type": "number" },
        "image": { "type": "string" },
        "warrantyMonths": { "type": "number" }
      },
      "required": ["id", "name", "priceUsd"]
    },
    "orders": {
      "title": "Orders",
      "description": "Customer purchase orders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "totalDzd": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "tickets": {
      "title": "Tickets",
      "description": "Repair tickets booked by customers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    }
  },
  "securityRules": [
    {
      "collection": "products",
      "read": "true",
      "write": "true"
    },
    {
      "collection": "orders",
      "read": "true",
      "write": "true"
    },
    {
      "collection": "tickets",
      "read": "true",
      "write": "true"
    }
  ]
}
